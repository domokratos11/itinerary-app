rules_version = '2';

// Access needs a Google sign-in whose email is on the trip's member list; a
// leaked link alone opens nothing. People see only their own trips, only the
// emails in config/access can create one, and trips are never deleted. Inside
// a trip only what's already retired can be deleted (Clean up in Settings).
// The one exception to sign-in is shares/{shareId}: a read-only copy without
// amounts that members publish, readable by its ID until it expires.
// The scripts use the Admin SDK, which these rules don't apply to.
// Paste this file into Firebase console → Firestore → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isPlanItem(d) {
      return d.keys().hasOnly(['id', 'placeId', 'date', 'order', 'status', 'updatedAt'])
        && d.keys().hasAll(['id', 'placeId', 'date', 'order', 'status', 'updatedAt'])
        && d.id is string && d.id.size() > 0 && d.id.size() <= 64
        && d.placeId is string && d.placeId.size() > 0 && d.placeId.size() <= 64
        && d.date is string && d.date.size() == 10
        && d.order is string && d.order.size() > 0 && d.order.size() <= 64
        && d.status in ['planned', 'done', 'skipped', 'removed']
        && d.updatedAt is string && d.updatedAt.size() <= 30;
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    function optionalString(v, max) {
      return v == null || shortString(v, max);
    }

    function optionalNumber(v) {
      return v == null || v is number;
    }

    function isRecord(d) {
      return d.archived is bool && shortString(d.updatedAt, 30);
    }

    // Added later and optional, so older documents stay valid.
    function hasValidMapFields(d) {
      return optionalString(d.get('googlePlaceId', null), 300)
        && optionalString(d.get('locationFetchedAt', null), 30)
        && (d.get('locationSource', null) == null
          || d.get('locationSource', null) in ['google', 'manual']);
    }

    function isNearestStation(v) {
      return v == null || (v is map
        && v.keys().hasOnly(['name', 'lines', 'walkMin'])
        && v.keys().hasAll(['name', 'lines', 'walkMin'])
        && shortString(v.name, 100) && v.name.size() > 0
        && v.lines is list && v.lines.size() <= 8
        && optionalNumber(v.walkMin));
    }

    // One day's research, keyed by its date. The analysis is the researcher's
    // own words; its inside is checked by the app's schema.
    function isDayResearch(d) {
      return d.keys().hasOnly(['id', 'date', 'status', 'request', 'analysis', 'requestedAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'date', 'status', 'request', 'analysis', 'requestedAt', 'updatedAt'])
        && shortString(d.id, 10) && d.id == d.date
        && d.status in ['requested', 'ready', 'archived']
        && optionalString(d.request, 1000)
        && (d.analysis == null || (d.analysis is map && d.analysis.size() <= 10))
        && shortString(d.requestedAt, 30)
        && shortString(d.updatedAt, 30);
    }

    function isProposal(d) {
      return d.keys().hasOnly(['id', 'placeId', 'status', 'fields', 'sources', 'notes', 'requestedAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'placeId', 'status', 'fields', 'sources', 'notes', 'requestedAt', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.placeId, 64) && d.placeId.size() > 0
        && d.status in ['requested', 'ready', 'applied', 'dismissed']
        && d.fields is map && d.fields.size() <= 20
        && d.sources is list && d.sources.size() <= 60
        && optionalString(d.notes, 2000)
        && shortString(d.requestedAt, 30)
        && shortString(d.updatedAt, 30);
    }

    function isCity(d) {
      return d.keys().hasOnly(['id', 'name', 'color', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'name', 'color', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.name, 100) && d.name.size() > 0
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
        && isRecord(d);
    }

    function isStay(d) {
      return d.keys().hasOnly(['id', 'cityId', 'hotelName', 'hotelMapsUrl', 'lat', 'lng', 'checkIn', 'checkOut', 'note', 'googlePlaceId', 'locationFetchedAt', 'locationSource', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'cityId', 'hotelName', 'hotelMapsUrl', 'lat', 'lng', 'checkIn', 'checkOut', 'note', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.cityId, 64)
        && shortString(d.hotelName, 200) && d.hotelName.size() > 0
        && optionalString(d.hotelMapsUrl, 500)
        && optionalNumber(d.lat) && optionalNumber(d.lng)
        && d.checkIn is string && d.checkIn.size() == 10
        && d.checkOut is string && d.checkOut.size() == 10
        && d.checkOut > d.checkIn
        && optionalString(d.note, 500)
        && hasValidMapFields(d)
        && isRecord(d);
    }

    function isReservation(d) {
      return d.keys().hasOnly(['id', 'type', 'date', 'time', 'from', 'to', 'note', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'type', 'date', 'time', 'from', 'to', 'note', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && d.type in ['flight', 'train', 'hotel', 'tour', 'ticket']
        && d.date is string && d.date.size() == 10
        && (d.time == null || (d.time is string && d.time.size() == 5))
        && optionalString(d.from, 100) && optionalString(d.to, 100)
        && optionalString(d.note, 500)
        && isRecord(d);
    }

    function isHoliday(d) {
      return d.keys().hasOnly(['id', 'date', 'name', 'kind', 'note', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'date', 'name', 'kind', 'note', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && d.date is string && d.date.size() == 10
        && shortString(d.name, 100) && d.name.size() > 0
        && d.kind in ['holiday', 'closures']
        && optionalString(d.note, 500)
        && isRecord(d);
    }

    function isFlight(d) {
      return d.keys().hasOnly(['id', 'airline', 'flightNumber', 'departDate', 'departTime', 'departAirport', 'departCity', 'arriveDate', 'arriveTime', 'arriveAirport', 'arriveCity', 'confirmation', 'costAmount', 'costCurrency', 'note', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'airline', 'flightNumber', 'departDate', 'departTime', 'departAirport', 'departCity', 'arriveDate', 'arriveTime', 'arriveAirport', 'arriveCity', 'confirmation', 'costAmount', 'costCurrency', 'note', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.airline, 100) && d.airline.size() > 0
        && shortString(d.flightNumber, 20) && d.flightNumber.size() > 0
        && d.departDate is string && d.departDate.size() == 10
        && d.departTime is string && d.departTime.size() == 5
        && d.departAirport is string && d.departAirport.size() == 3
        && optionalString(d.departCity, 100)
        && d.arriveDate is string && d.arriveDate.size() == 10
        && d.arriveTime is string && d.arriveTime.size() == 5
        && d.arriveAirport is string && d.arriveAirport.size() == 3
        && optionalString(d.arriveCity, 100)
        && optionalString(d.confirmation, 40)
        && optionalNumber(d.costAmount)
        && d.costCurrency in ['USD', 'JPY']
        && optionalString(d.note, 500)
        && isRecord(d);
    }

    function isPlace(d) {
      return d.keys().hasOnly(['id', 'cityId', 'mapsUrl', 'name', 'lat', 'lng', 'category', 'purpose', 'description', 'tips', 'costEstimateJPY', 'durationMin', 'openingHours', 'closedDates', 'seasonFrom', 'seasonTo', 'priority', 'verifiedAt', 'websiteUrl', 'notes', 'status', 'source', 'googlePlaceId', 'locationFetchedAt', 'locationSource', 'nearestStation', 'sources', 'lockedFields', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'cityId', 'mapsUrl', 'name', 'lat', 'lng', 'category', 'purpose', 'description', 'tips', 'costEstimateJPY', 'durationMin', 'openingHours', 'closedDates', 'seasonFrom', 'seasonTo', 'priority', 'verifiedAt', 'websiteUrl', 'notes', 'status', 'source', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.cityId, 64)
        && shortString(d.mapsUrl, 500)
        && shortString(d.name, 200) && d.name.size() > 0
        && optionalNumber(d.lat) && optionalNumber(d.lng)
        && d.category in ['lights', 'food', 'shopping', 'sight', 'daytrip', 'temple']
        && optionalString(d.purpose, 1000) && optionalString(d.description, 3000)
        && d.tips is list && d.tips.size() <= 30
        && optionalNumber(d.costEstimateJPY) && optionalNumber(d.durationMin)
        && optionalString(d.openingHours, 500)
        && d.closedDates is list && d.closedDates.size() <= 60
        && optionalString(d.seasonFrom, 10) && optionalString(d.seasonTo, 10)
        && d.priority in ['must', 'want', 'maybe']
        && optionalString(d.verifiedAt, 10)
        && optionalString(d.websiteUrl, 500)
        && optionalString(d.notes, 2000)
        && d.status in ['draft', 'researched']
        && d.source in ['catalog', 'queue']
        && hasValidMapFields(d)
        && isNearestStation(d.get('nearestStation', null))
        && d.get('sources', []) is list && d.get('sources', []).size() <= 60
        && d.get('lockedFields', []) is list && d.get('lockedFields', []).size() <= 40
        && isRecord(d);
    }

    function isActivity(d) {
      return d.keys().hasOnly(['id', 'at', 'device', 'kind', 'targetId', 'summary', 'before', 'after'])
        && d.keys().hasAll(['id', 'at', 'device', 'kind', 'targetId', 'summary', 'before', 'after'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.at, 30)
        && shortString(d.device, 40) && d.device.size() > 0
        && d.kind in ['added', 'moved', 'reordered', 'edited', 'removed', 'restored', 'undone', 'queued', 'assigned', 'dismissed', 'settings']
        && optionalString(d.targetId, 64)
        && shortString(d.summary, 300) && d.summary.size() > 0
        && optionalString(d.before, 4000) && optionalString(d.after, 4000);
    }

    function isExpense(d) {
      return d.keys().hasOnly(['id', 'title', 'amountJPY', 'category', 'date', 'status', 'paidBy', 'placeId', 'reservationId', 'stayId', 'cityId', 'originalUSD', 'rateJPYPerUSD', 'paymentMethod', 'note', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'title', 'amountJPY', 'category', 'date', 'status', 'paidBy', 'note', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.title, 200) && d.title.size() > 0
        && d.amountJPY is int && d.amountJPY >= 0
        && d.category in ['flight', 'booking', 'transport', 'food', 'souvenirs', 'attractions', 'clothes', 'temples', 'other']
        && d.date is string && d.date.size() == 10
        && d.status in ['planned', 'paid']
        && optionalString(d.paidBy, 254)
        && optionalString(d.get('placeId', null), 64)
        && optionalString(d.get('reservationId', null), 64)
        && optionalString(d.get('stayId', null), 64)
        && optionalString(d.get('cityId', null), 64)
        && (d.get('originalUSD', null) == null
          || (d.originalUSD is number && d.originalUSD >= 0))
        && (d.get('rateJPYPerUSD', null) == null
          || (d.rateJPYPerUSD is number && d.rateJPYPerUSD > 0))
        && d.get('paymentMethod', 'card') in ['card', 'cash']
        && optionalString(d.note, 500)
        && isRecord(d);
    }

    // Cash taken from an ATM or handed to another member. Kept apart from
    // expenses, so it never counts as spending.
    function isCash(d) {
      return d.keys().hasOnly(['id', 'kind', 'date', 'amountJPY', 'amountUSD', 'by', 'to', 'note', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'kind', 'date', 'amountJPY', 'amountUSD', 'by', 'to', 'note', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && d.kind in ['withdrawal', 'handover']
        && d.date is string && d.date.size() == 10
        && d.amountJPY is int && d.amountJPY >= 0
        && (d.amountUSD == null || (d.amountUSD is number && d.amountUSD >= 0))
        && shortString(d.by, 254) && d.by.size() > 0
        && optionalString(d.to, 254)
        && (d.kind == 'withdrawal' || (d.to != null && d.to != d.by))
        && optionalString(d.note, 500)
        && isRecord(d);
    }

    // A to-do list, and one to-do on it.
    function isTodoList(d) {
      return d.keys().hasOnly(['id', 'title', 'description', 'color', 'order', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'title', 'description', 'color', 'order', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.title, 120) && d.title.size() > 0
        && optionalString(d.description, 1000)
        && d.color is string && d.color.matches('^#[0-9a-fA-F]{6}$')
        && d.order is int
        && isRecord(d);
    }

    function isTodo(d) {
      return d.keys().hasOnly(['id', 'listId', 'title', 'description', 'dueDate', 'status', 'priority', 'assignee', 'order', 'completedAt', 'archived', 'updatedAt'])
        && d.keys().hasAll(['id', 'listId', 'title', 'description', 'dueDate', 'status', 'priority', 'assignee', 'order', 'completedAt', 'archived', 'updatedAt'])
        && shortString(d.id, 64) && d.id.size() > 0
        && shortString(d.listId, 64) && d.listId.size() > 0
        && shortString(d.title, 200) && d.title.size() > 0
        && optionalString(d.description, 2000)
        && (d.dueDate == null || (d.dueDate is string && d.dueDate.size() == 10))
        && d.status in ['todo', 'inProgress', 'done']
        && d.priority in ['low', 'normal', 'high']
        && optionalString(d.assignee, 254)
        && d.order is int
        && optionalString(d.completedAt, 30)
        && isRecord(d);
    }

    function isBudget(v) {
      return v == null || (v is map
        && v.keys().hasOnly(['totalJPY', 'byCategory', 'travellers', 'byMember'])
        && v.keys().hasAll(['totalJPY', 'byCategory', 'travellers'])
        && (v.totalJPY == null || (v.totalJPY is int && v.totalJPY >= 0))
        && v.byCategory is map
        && v.byCategory.keys().hasOnly(['flight', 'booking', 'transport', 'food', 'souvenirs', 'attractions', 'clothes', 'temples', 'other'])
        && (v.travellers == null || (v.travellers is int && v.travellers > 0 && v.travellers <= 20))
        && v.get('byMember', {}) is map && v.get('byMember', {}).size() <= 20);
    }

    function isSignedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Signed in with Google, and that email is on the trip document's
    // `members` list (lowercase emails). A missing trip fails too, so nobody
    // can probe which IDs exist.
    function isMember(tripId) {
      return isSignedIn()
        && myEmail() in
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('members', []);
    }

    // The emails allowed to create trips, edited only in the console. Google
    // sign-in accepts any account, so this keeps strangers from creating them.
    function isTripCreator() {
      return isSignedIn()
        && myEmail() in
          get(/databases/$(database)/documents/config/access).data.get('tripCreators', []);
    }

    // At most 20 people, and never a list that leaves out the person saving
    // it, so nobody can lock themselves out.
    function isMemberList(members) {
      return members is list
        && members.size() > 0 && members.size() <= 20
        && myEmail() in members;
    }

    function isNewTrip(d) {
      return d.keys().hasOnly(['name', 'members', 'createdBy', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'members', 'createdBy', 'createdAt', 'updatedAt'])
        && shortString(d.name, 100) && d.name.size() > 0
        && isMemberList(d.members)
        && d.createdBy == myEmail()
        && shortString(d.createdAt, 30)
        && shortString(d.updatedAt, 30);
    }

    function isTripEdit(after, before) {
      return after.diff(before).affectedKeys().hasOnly(['name', 'members', 'budget', 'updatedAt'])
        && shortString(after.get('name', 'unnamed'), 100)
        && after.get('name', 'unnamed').size() > 0
        && isMemberList(after.members)
        && isBudget(after.get('budget', null))
        && shortString(after.updatedAt, 30);
    }

    function isUserProfile(d) {
      return d.keys().hasOnly(['language', 'lastTripId', 'updatedAt'])
        && (!('language' in d) || d.language == null || d.language in ['en', 'es'])
        && (!('lastTripId' in d) || optionalString(d.lastTripId, 128))
        && shortString(d.updatedAt, 30);
    }

    // A read-only link. Anyone with its ID may read it and its copy of the
    // trip until it expires or is revoked; at most 30 days ahead (plus an
    // hour for clock drift), and a revoked link stays revoked.
    function isShare(d) {
      return d.keys().hasOnly(['tripId', 'tripName', 'label', 'createdAt', 'expiresAt', 'revoked', 'publishedAt'])
        && d.keys().hasAll(['tripId', 'tripName', 'label', 'createdAt', 'expiresAt', 'revoked', 'publishedAt'])
        && shortString(d.tripId, 128) && d.tripId.size() > 0
        && optionalString(d.tripName, 100)
        && shortString(d.label, 100)
        && shortString(d.createdAt, 30)
        && d.expiresAt is timestamp
        && d.expiresAt <= request.time + duration.value(30 * 24 + 1, 'h')
        && d.revoked is bool
        && shortString(d.publishedAt, 30);
    }

    function shareOf(shareId) {
      return get(/databases/$(database)/documents/shares/$(shareId)).data;
    }

    function isOpenShare(s) {
      return s.revoked == false && request.time < s.expiresAt;
    }

    // Copies may hold no amount and no booking note or confirmation.
    function isSharedCopy(name, d) {
      return (name == 'cities' && isCity(d))
        || (name == 'stays' && isStay(d) && d.note == null)
        || (name == 'reservations' && isReservation(d) && d.note == null)
        || (name == 'places' && isPlace(d) && d.costEstimateJPY == null)
        || (name == 'holidays' && isHoliday(d))
        || (name == 'flights' && isFlight(d) && d.confirmation == null
          && d.costAmount == null && d.note == null)
        || (name == 'items' && isPlanItem(d) && d.status != 'removed');
    }

    // Who may create trips. Readable only by the people on the list, so
    // nobody else can see it.
    match /config/access {
      allow get: if isSignedIn() && myEmail() in resource.data.get('tripCreators', []);
      allow list, write: if false;
    }

    // One person's preferences.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && isUserProfile(request.resource.data);
      allow list, delete: if false;
    }

    match /trips/{tripId} {
      allow get: if isMember(tripId);
      // Only with the query where members array-contains your own email.
      allow list: if isSignedIn() && myEmail() in resource.data.members;
      allow create: if isTripCreator() && isNewTrip(request.resource.data);
      allow update: if isMember(tripId)
        && isTripEdit(request.resource.data, resource.data);
      allow delete: if false;

      // The change log: written once and never edited; Clean up can clear it.
      match /activity/{id} {
        allow read: if isMember(tripId);
        allow create: if isMember(tripId)
          && isActivity(request.resource.data) && request.resource.data.id == id;
        allow update: if false;
        allow delete: if isMember(tripId);
      }

      // The trip's structure. Records are archived, and only archived ones can
      // be deleted.
      match /cities/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isCity(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /stays/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isStay(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /reservations/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isReservation(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /holidays/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isHoliday(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /flights/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isFlight(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /cash/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isCash(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /todoLists/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isTodoList(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /todos/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isTodo(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /expenses/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isExpense(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      match /places/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isPlace(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId) && resource.data.archived == true;
      }

      // Research waiting for review. Only finished research can be deleted.
      match /proposals/{id} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isProposal(request.resource.data) && request.resource.data.id == id;
        allow delete: if isMember(tripId)
          && resource.data.status in ['applied', 'dismissed'];
      }

      // Research of a whole day. Only archived research can be deleted.
      match /dayResearch/{date} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isDayResearch(request.resource.data) && request.resource.data.id == date;
        allow delete: if isMember(tripId) && resource.data.status == 'archived';
      }

      // Links left from the old Queue: they can only be read and cleaned up.
      match /queue/{queueId} {
        allow read, delete: if isMember(tripId);
        allow create, update: if false;
      }

      match /items/{itemId} {
        allow read: if isMember(tripId);
        allow create, update: if isMember(tripId)
          && isPlanItem(request.resource.data)
          && request.resource.data.id == itemId;
        allow delete: if isMember(tripId) && resource.data.status == 'removed';
      }
    }

    // Read-only links. The only thing readable without signing in, and only
    // by ID: nobody can list them except the trip's members.
    match /shares/{shareId} {
      allow get: if isOpenShare(resource.data) || isMember(resource.data.tripId);
      // Only with the query where tripId == the member's trip.
      allow list: if isMember(resource.data.tripId);
      allow create: if isMember(request.resource.data.tripId)
        && isShare(request.resource.data)
        && request.resource.data.revoked == false
        && request.resource.data.expiresAt > request.time;
      allow update: if isMember(resource.data.tripId)
        && isShare(request.resource.data)
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.revoked == true || resource.data.revoked == false);
      // Clean up, once the link is closed.
      allow delete: if isMember(resource.data.tripId)
        && (resource.data.revoked == true || request.time >= resource.data.expiresAt);

      // The link's copy of the trip. Members rewrite it on Refresh, which
      // deletes copies of records that are gone; the trip itself is untouched.
      match /{name}/{id} {
        allow read: if isOpenShare(shareOf(shareId)) || isMember(shareOf(shareId).tripId);
        allow create, update: if isMember(shareOf(shareId).tripId)
          && isSharedCopy(name, request.resource.data)
          && request.resource.data.id == id;
        allow delete: if isMember(shareOf(shareId).tripId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
